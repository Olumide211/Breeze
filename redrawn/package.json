  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render Redrawn out/redrawn.mp4 --codec=h264 --muted && npm run contact",
    "contact": "ffmpeg -y -loglevel error -i out/redrawn.mp4 -vf \"select=not(mod(n\\,6)),scale=256:144,tile=12x7:padding=2:color=0x888888\" -frames:v 1 out/contact.png",
    "cast": "remotion still Cast out/cast.png",
    "stills": "node scripts/stills.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}